PUBLIC_URL=https://passwords.example.org
HTTP_BIND=127.0.0.1
HTTP_PORT=3000
TRUST_PROXY=1
TRUSTED_PROXIES=127.0.0.1,::1
DEPLOYMENT_KEY_FILE=./secrets/deployment-key
SETUP_TOKEN_FILE=./secrets/setup-token
DB_PASSWORD_FILE=./secrets/db-password
DB_APP_PASSWORD_FILE=./secrets/db-password-app
DB_ROOT_PASSWORD_FILE=./secrets/db-root-password
# Published releases only: paste the image@sha256 reference from release-manifest.json.
# NODEPASS_IMAGE=ghcr.io/sapientorius/nodepass@sha256:REPLACE_WITH_VERIFIED_DIGEST
# Local development only:
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=nodepass
# DB_NAME=nodepass
# DATA_DIR=./data
# SYSPASS_CONFIG=/absolute/path/to/config.xml
# TRUST_PROXY=1 only behind an isolated trusted reverse proxy.
