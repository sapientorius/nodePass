{
  "name": "nodepass",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted sysPass successor with a Feathers 5 API and Vue 3 UI",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "preview": "node scripts/preview.mjs",
    "rtk:preview": "rtk npm run preview",
    "preview:stop": "node scripts/preview.mjs stop",
    "rtk:preview:stop": "rtk npm run preview:stop",
    "preview:logs": "node scripts/preview.mjs logs",
    "rtk:preview:logs": "rtk npm run preview:logs",
    "preview:reset": "node scripts/preview.mjs reset",
    "rtk:preview:reset": "rtk npm run preview:reset",
    "dev": "tsx watch packages/server/src/index.ts",
    "rtk:dev": "rtk npm run dev",
    "build": "node scripts/clean-build.mjs && npm run build -w @nodepass/contracts && npm run build -w @nodepass/server && npm run build -w @nodepass/web && node scripts/copy-resources.mjs",
    "rtk:build": "rtk npm run build",
    "typecheck": "tsc --noEmit -p packages/server && vue-tsc --noEmit -p packages/web",
    "rtk:typecheck": "rtk npm run typecheck",
    "test": "vitest run",
    "rtk:test": "rtk npm test",
    "test:coverage": "vitest run --coverage",
    "rtk:test:coverage": "rtk npm run test:coverage",
    "test:e2e": "playwright test",
    "rtk:test:e2e": "rtk npm run test:e2e",
    "lint": "eslint .",
    "rtk:lint": "rtk npm run lint",
    "format:check": "prettier --check .",
    "rtk:format:check": "rtk npm run format:check",
    "format": "prettier --write .",
    "rtk:format": "rtk npm run format",
    "audit": "npm audit --audit-level=high",
    "rtk:audit": "rtk npm run audit",
    "check:assets": "node scripts/check-assets.mjs",
    "rtk:check:assets": "rtk npm run check:assets",
    "cli": "tsx packages/server/src/cli.ts",
    "rtk:cli": "rtk npm run cli",
    "start": "node packages/server/dist/server/src/index.js",
    "rtk:start": "rtk npm start",
    "audit:rules": "node scripts/audit-rules.mjs",
    "rtk:audit:rules": "rtk npm run audit:rules",
    "test:integration": "node scripts/run-integration.mjs",
    "rtk:test:integration": "rtk npm run test:integration",
    "audit:zap": "node scripts/zap.mjs",
    "rtk:audit:zap": "rtk npm run audit:zap",
    "check:exceptions": "node scripts/check-exceptions.mjs",
    "rtk:check:exceptions": "rtk npm run check:exceptions",
    "test:matrix": "node scripts/matrix.mjs",
    "rtk:test:matrix": "rtk npm run test:matrix",
    "test:container": "node scripts/test-container.mjs",
    "rtk:test:container": "rtk npm run test:container",
    "clean:build": "node scripts/clean-build.mjs",
    "rtk:clean:build": "rtk npm run clean:build",
    "check:publication": "node scripts/check-publication.mjs",
    "rtk:check:publication": "rtk npm run check:publication",
    "check:compose": "node scripts/check-compose.mjs",
    "rtk:check:compose": "rtk npm run check:compose",
    "check:release": "node scripts/check-release.mjs",
    "rtk:check:release": "rtk npm run check:release",
    "release:version": "node scripts/release-version.mjs",
    "rtk:release:version": "rtk npm run release:version",
    "release:prepare": "node scripts/prepare-release.mjs",
    "rtk:release:prepare": "rtk npm run release:prepare"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/koa": "^3.0.3",
    "@types/koa__router": "^12.0.0",
    "@types/koa-static": "^4.0.4",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.5.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.1.0",
    "yaml": "^2.9.1"
  }
}
